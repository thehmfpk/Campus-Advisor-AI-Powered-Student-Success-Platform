# ─────────────────────────────────────────────────────────────────────────────
# Campus Advisor — environment variables (ALL FREE TIER, no credit card)
# Copy to `.env` for local dev. In production set these in the Vercel dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# --- Frontend (safe to expose; prefixed with VITE_) -------------------------
# Supabase Free project: https://supabase.com (free tier, no card required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-only (NEVER prefixed with VITE_, never sent to the browser) -----
# Supabase service-role key — used only by /api serverless functions & seed.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (free tier) ------------------------------------------------
# AI_MODE: "free" uses FreeAIProvider; "mock" (or leaving AI_API_KEY empty)
# uses the deterministic MockAIProvider so the demo works with zero cost/keys.
AI_MODE=mock
# Free-tier, OpenAI-compatible endpoints (pick one; no credit card):
#   Groq:   AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.1-8b-instant
#   Gemini: via OpenAI-compat base URL + a Gemini free key
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# --- Admin bootstrap --------------------------------------------------------
# Comma-separated emails promoted to admin by the seed script (never self-signup).
ADMIN_EMAILS=
